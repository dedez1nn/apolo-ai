# Credenciais do Proton Bridge (usuário/senha do Bridge, não da conta Proton).
APOLO_IMAP_HOST=127.0.0.1
APOLO_IMAP_PORT=1143
APOLO_USERNAME=seu_usuario_do_bridge
# A senha do Bridge fica no keyring do SO (libsecret), não no .env. Defina pela
# tela de Configurações da UI. (APOLO_PASSWORD ainda funciona como fallback, mas
# o keyring tem precedência sobre o valor do .env.)
APOLO_IMAP_SECURITY=STARTTLS
APOLO_SMTP_PORT=1025
# Pastas a vigiar (separadas por vírgula).
APOLO_FOLDERS=INBOX
# Opcional: caminho do banco. Padrão: ~/.local/share/apolo/apolo.db
# APOLO_DB_PATH=

# Botão "Sincronizar" da UI: quantas mensagens mais recentes por pasta/conta
# buscar num full-scan, ignorando o ponteiro incremental (0 = sem limite).
APOLO_SYNC_LIMIT=500

# Gmail OAuth2 — necessário para usar contas Gmail.
# Crie um projeto no Google Cloud Console, ative a Gmail API e gere um
# Client ID do tipo "Desktop app" (não "TV and Limited Input Devices").
# APOLO_GMAIL_CLIENT_ID=
# APOLO_GMAIL_CLIENT_SECRET=

# IA (Ollama) — classifica só o resíduo. Se o Ollama estiver fora, é pulada.
APOLO_AI_ENABLED=true
APOLO_OLLAMA_URL=http://127.0.0.1:11434
APOLO_OLLAMA_MODEL=llama3.2
APOLO_OLLAMA_KEEP_ALIVE=30m
