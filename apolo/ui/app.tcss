/* Apolo · tema "Liquid Glass" — azul-ardósia frio, acento azure, painéis com
   borda suave (vidro) e um "gutter de veredito" colorido por ação. As cores
   vêm do Theme (apolo/ui/theme.py): $primary=azure, $lixeira/$manter/$revisar. */

Screen {
    background: $background;
    layout: vertical;
    align: left top;
}

/* ---------- barra de atalhos (rodapé custom) ---------- */
.keybar {
    dock: bottom;
    height: 2;
    width: 100%;
    background: $surface;
    border-top: tall $edge;
    padding: 0 1;
    content-align: left middle;
    text-wrap: nowrap;
}

/* faixa de cabeçalho reutilizada pelas telas (título + meta + hairline) */
.band {
    height: auto;
    width: 100%;
    background: $surface;
    border-bottom: tall $edge;
    padding: 1 2;
    color: $foreground;
}

/* mensagem transitória (1 linha, acima da keybar) */
.flash {
    height: 1;
    width: 100%;
    padding: 0 2;
    color: $accent;
}

/* ======================= HUB (mestre-detalhe) ======================= */
#hub-root {
    width: 100%;
    height: 1fr;
}

#masthead {
    height: 3;
    width: 100%;
    background: $surface;
    border-bottom: tall $edge;
    padding: 0 2;
}

#mast-brand {
    width: 1fr;
    content-align: left middle;
    color: $accent;
    text-style: bold;
    text-wrap: nowrap;
}

#mast-stats {
    width: auto;
    content-align: right middle;
    color: $text-muted;
    text-wrap: nowrap;
}

#hub-body {
    width: 100%;
    height: 1fr;
    padding: 1 1 0 1;
}

#hub-menu {
    width: 42;
    height: 1fr;
    background: $panel;
    border: round $primary 30%;
    padding: 1 1;
    margin-right: 1;
}

#hub-detail {
    width: 1fr;
    height: 1fr;
    background: $panel;
    border: round $primary 20%;
    padding: 1 2;
}

#hub-detail-body {
    width: 100%;
    height: auto;
}

.menu-item {
    layout: horizontal;
    height: 1;
    padding: 0 1;
    margin: 0 0;
    background: transparent;
    border-left: tall transparent;
}

.menu-item > .mi-icone {
    width: 3;
    content-align: left middle;
    color: $accent;
}

.menu-item > .mi-rotulo {
    width: 1fr;
    content-align: left middle;
}

.menu-item > .mi-badge {
    width: auto;
    color: $accent;
    text-style: bold;
}

#hub-menu > .menu-item.-highlight {
    background: $primary 22%;
    border-left: tall $accent;
    text-style: bold;
}

#hub-menu > .menu-item.-highlight > .mi-rotulo {
    color: $text;
}

/* ======================= FILA DE REVISÃO ======================= */
#q-list {
    height: 1fr;
    width: 100%;
    background: transparent;
    border: none;
    padding: 0 1;
}

.email-row {
    height: 2;
    padding: 0 1;
    background: transparent;
    border-left: tall transparent;
}

.email-row.v-lixeira { border-left: tall $lixeira; }
.email-row.v-manter  { border-left: tall $manter; }
.email-row.v-revisar { border-left: tall $revisar; }

.email-row.-highlight {
    background: $accent 55%;
}

.er-sub {
    color: $text-muted;
}

/* ======================= MODO SWIPE ======================= */
#sw-stage {
    height: 1fr;
    width: 100%;
    align: center middle;
}

/* ======================= REGRAS ======================= */
#rules-list {
    height: 1fr;
    width: 100%;
    background: transparent;
    border: none;
    padding: 0 1;
}

.rule-row {
    height: 1;
    padding: 0 1;
    background: transparent;
    border-left: tall transparent;
}

.rule-row.v-allow { border-left: tall $manter; }
.rule-row.v-block { border-left: tall $lixeira; }

.rule-row.-highlight {
    background: $accent 55%;
}

/* ======================= PRÉVIA ======================= */
#prev-scroll {
    height: 1fr;
    width: 100%;
    padding: 0 2;
}

#prev-body {
    height: auto;
    width: 100%;
    padding: 0 0 1 0;
}

/* ======================= STATUS ======================= */
#status-scroll {
    height: 1fr;
    width: 100%;
    padding: 1 2;
}

#status-body {
    height: auto;
    width: 100%;
}

/* ======================= SUGESTÕES ======================= */
#sug-list {
    height: 1fr;
    width: 100%;
    padding: 1 2;
}

.sug-row {
    height: auto;
    align: left middle;
    padding: 0 0 1 0;
}

.sug-txt {
    width: 1fr;
    height: auto;
}

.sug-switch {
    width: auto;
    margin-left: 2;
}

/* ======================= CONFIGURAÇÕES ======================= */
#cfg {
    width: 100%;
    height: 1fr;
    padding: 1 3;
    background: transparent;
}

.cfg-sec {
    margin-top: 1;
    color: $accent;
    text-style: bold;
}

.cfg-row {
    height: 3;
    align: left middle;
}

.cfg-lbl {
    width: 22;
    content-align: left middle;
    color: $text-muted;
}

.cfg-row > Select {
    width: 28;
}

.cfg-row > Input {
    width: 40;
}

#cfg-actions {
    height: auto;
    margin-top: 1;
}

#cfg-actions > Button {
    margin-right: 2;
}

/* ======================= MODAIS ======================= */
AddRuleModal, EditRuleModal, RunModal, CodeModal, DispatchModal, GmailSetupModal, ImapSetupModal, EmailPreviewModal {
    align: center middle;
}

#gmail-box, #imap-box {
    width: 72;
    max-width: 95%;
    height: auto;
    padding: 1 2;
    border: round $accent;
    background: $panel;
}

#gmail-hint {
    color: $text-muted;
    margin-bottom: 1;
}

#g-url, #g-code {
    height: auto;
    padding: 0 0 1 0;
}

#g-status, #g-result {
    height: auto;
    margin-top: 1;
}

#add-box {
    width: 80;
    max-width: 95%;
    height: auto;
    padding: 1 2;
    border: round $accent;
    background: $panel;
}

.cfg-title {
    color: $accent;
    text-style: bold;
    margin-bottom: 1;
}

#r-lista {
    width: 32;
}

#r-tipo {
    height: 1;
    padding: 0 0 1 0;
}

#r-preview {
    height: auto;
    min-height: 3;
    max-height: 14;
    padding: 1 0;
    border-top: dashed $primary 40%;
}

#run-box {
    width: 64;
    max-width: 90%;
    height: auto;
    padding: 1 2;
    border: round $accent;
    background: $panel;
}

#run-msg {
    padding: 0;
    color: $foreground;
}

#code-box {
    width: 80;
    max-width: 95%;
    height: auto;
    max-height: 80%;
    padding: 1 2;
    border: round $accent;
    background: $panel;
}

#code-msg {
    padding: 0 0 1 0;
    color: $foreground;
}

#code-list {
    height: auto;
    max-height: 16;
    background: transparent;
    border: none;
}

#code-list > ListItem {
    padding: 0 1;
    background: transparent;
}

#code-list > ListItem.-highlight {
    background: $primary 22%;
}

#mail-box {
    width: 124;
    max-width: 96%;
    height: 90%;
    max-height: 96%;
    border: round $accent;
    background: $panel;
}

#mail-head {
    height: auto;
    padding: 1 2;
    border-bottom: tall $edge;
}

#mail-status {
    height: auto;
    min-height: 1;
    padding: 0 2;
    color: $text-muted;
}

#mail-scroll {
    height: 1fr;
    width: 100%;
    padding: 1 2;
}

#mail-page {
    width: 100%;
    height: auto;
    background: $surface;
    border: round $primary 20%;
    padding: 1 2;
}

.mail-block {
    width: 100%;
    height: auto;
    padding: 0 0 1 0;
}

.mail-h1, .mail-h2, .mail-h3, .mail-h4, .mail-h5, .mail-h6 {
    padding: 1 0 0 0;
}

/* Texto solto em célula de tabela de layout: linhas contíguas, sem o
   respiro de parágrafo entre cada fragmento. */
.mail-cell {
    padding: 0;
}

.mail-pre, .mail-table {
    background: $background 35%;
    border-left: tall $edge;
    padding: 1 1 1 2;
}

.mail-img-wrap {
    width: 100%;
    height: auto;
    align: center middle;
    padding: 1 0 0 0;
}

.mail-img {
    width: auto;
    height: auto;
    max-width: 100%;
}

.mail-img-caption {
    width: 100%;
    height: auto;
    padding: 0 0 1 0;
    color: $text-muted;
    content-align: center top;
}
