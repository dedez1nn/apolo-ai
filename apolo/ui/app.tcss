/* Tema dark do Apolo — superfícies escuras, acento ciano, cantos arredondados.
   A vibe "liquid glass" vem das bordas suaves + realce no item focado. */

Screen {
    background: $background;
    align: center top;
}

/* ---------- Hub ---------- */
#hub {
    width: 70;
    max-width: 90%;
    height: auto;
    margin-top: 2;
    padding: 1 2;
    border: round $primary 60%;
    background: $surface;
}

#hub-title {
    color: $accent;
    text-style: bold;
    padding: 0 1;
}

#hub-stats {
    color: $text-muted;
    margin-bottom: 1;
}

#hub-menu {
    height: auto;
    background: transparent;
    border: none;
}

.menu-item {
    layout: horizontal;
    height: 1;
    padding: 0 1;
    background: transparent;
}

.menu-item.soon {
    color: $text-muted;
}

.menu-item > .mi-icone {
    width: 4;
    content-align: center middle;
}

.menu-item > .mi-rotulo {
    width: 1fr;
}

.menu-item > .mi-badge {
    width: auto;
    color: $accent;
    text-style: bold;
}

/* Realce do item sob o cursor — o "selecionado com a seta". */
#hub-menu > .menu-item.-highlight {
    background: $primary 25%;
    color: $text;
    text-style: bold;
}

/* ---------- Fila de revisão ---------- */
#q-header {
    padding: 1 2 0 2;
    height: auto;
}

#q-list {
    height: 1fr;
    background: transparent;
    border: none;
    padding: 0 1;
}

.email-row {
    height: 2;
    padding: 0 1;
    background: transparent;
}

.email-row.-highlight {
    background: $primary 22%;
}

.er-sub {
    color: $text-muted;
}

#q-msg {
    height: 1;
    padding: 0 2;
    color: $accent;
}

/* ---------- Configurações ---------- */
#cfg {
    width: 76;
    max-width: 95%;
    height: auto;
    max-height: 1fr;
    margin: 1 0;
    padding: 1 2;
    border: round $primary 60%;
    background: $surface;
}

.cfg-title {
    color: $accent;
    text-style: bold;
    margin-bottom: 1;
}

.cfg-sec {
    margin-top: 1;
    color: $text;
}

.cfg-row {
    height: 3;
    align: left middle;
}

.cfg-lbl {
    width: 22;
    content-align: left middle;
    color: $text-muted;
}

.cfg-row > Select {
    width: 24;
}

.cfg-row > Input {
    width: 32;
}

#cfg-actions {
    height: auto;
    margin-top: 1;
}

#cfg-actions > Button {
    margin-right: 2;
}

#cfg-msg {
    height: 1;
    padding: 0 2;
    color: $accent;
}

/* ---------- Regras (listar/remover) ---------- */
#rules {
    width: 80;
    max-width: 95%;
    height: 1fr;
    margin: 1 0;
    padding: 1 2;
    border: round $primary 60%;
    background: $surface;
}

#rules-header {
    height: auto;
    padding: 0 0 1 0;
}

#rules-list {
    height: 1fr;
    background: transparent;
    border: none;
}

.rule-row {
    height: 1;
    padding: 0 1;
    background: transparent;
}

.rule-row.-highlight {
    background: $primary 22%;
}

#rules-msg {
    height: 1;
    padding: 0 2;
    color: $accent;
}

/* ---------- Modal: adicionar regra ---------- */
AddRuleModal {
    align: center middle;
}

#add-box {
    width: 76;
    max-width: 95%;
    height: auto;
    padding: 1 2;
    border: round $accent;
    background: $surface;
}

#r-lista {
    width: 30;
}

#r-tipo {
    height: 1;
    padding: 0 0 1 0;
}

#r-preview {
    height: auto;
    min-height: 3;
    max-height: 12;
    padding: 1 0;
    border-top: dashed $primary 40%;
}

/* ---------- Modal: rodar agora ---------- */
RunModal {
    align: center middle;
}

#run-box {
    width: 60;
    max-width: 90%;
    height: auto;
    padding: 1 2;
    border: round $accent;
    background: $surface;
}

#run-msg {
    padding: 0 0 0 0;
    color: $text;
}

/* ---------- Prévia da cascata ---------- */
#prev-header {
    padding: 1 2 0 2;
    height: auto;
}

#prev-scroll {
    height: 1fr;
    padding: 0 1;
}

#prev-body {
    height: auto;
    padding: 0 1 2 1;
}

/* ---------- Status ---------- */
#status-box {
    width: 60;
    max-width: 90%;
    height: auto;
    margin-top: 2;
    padding: 1 2;
    border: round $primary 60%;
    background: $surface;
}
